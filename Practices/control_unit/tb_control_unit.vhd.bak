library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;
use STD.TEXTIO.ALL;
use IEEE.STD_LOGIC_TEXTIO.ALL;

entity tb_control_unit is
end tb_control_unit;

architecture Behavioral of tb_control_unit is
    -- Señales para el UUT (Unit Under Test)
    signal opcode    : STD_LOGIC_VECTOR(6 downto 0);
    signal RegWrite  : STD_LOGIC;
    signal ALUSrc    : STD_LOGIC;
    signal MemRead   : STD_LOGIC;
    signal MemWrite  : STD_LOGIC;
    signal MemToReg  : STD_LOGIC;
    signal Branch    : STD_LOGIC;
    signal Jump      : STD_LOGIC;
    signal ALUOP     : STD_LOGIC_VECTOR(2 downto 0);
    
    -- Constantes de tiempo
    constant clk_period : time := 10 ns;
    
    -- Componente a probar
    component control_unit
        Port (
            opcode    : in  STD_LOGIC_VECTOR(6 downto 0);
            RegWrite  : out STD_LOGIC;
            ALUSrc    : out STD_LOGIC;
            MemRead   : out STD_LOGIC;
            MemWrite  : out STD_LOGIC;
            MemToReg  : out STD_LOGIC;
            Branch    : out STD_LOGIC;
            Jump      : out STD_LOGIC;
            ALUOP     : out STD_LOGIC_VECTOR(2 downto 0)
        );
    end component;
    
    -- Procedimiento para mostrar resultados
    procedure print_signals(signal opcode_val : STD_LOGIC_VECTOR(6 downto 0);
                           instruction_name : string) is
        variable l : line;
    begin
        write(l, string'("=== ") & instruction_name & string'(" ==="));
        writeline(output, l);
        write(l, string'("Opcode: ") & to_string(opcode_val));
        writeline(output, l);
        write(l, string'("RegWrite: ") & std_logic'image(RegWrite) & 
                 string'(" | ALUSrc: ") & std_logic'image(ALUSrc) &
                 string'(" | MemRead: ") & std_logic'image(MemRead) &
                 string'(" | MemWrite: ") & std_logic'image(MemWrite));
        writeline(output, l);
        write(l, string'("MemToReg: ") & std_logic'image(MemToReg) &
                 string'(" | Branch: ") & std_logic'image(Branch) &
                 string'(" | Jump: ") & std_logic'image(Jump) &
                 string'(" | ALUOP: ") & to_string(ALUOP));
        writeline(output, l);
        write(l, string'(""));
        writeline(output, l);
    end procedure;

begin
    -- Instanciación de la unidad de control
    UUT: control_unit
        Port map (
            opcode   => opcode,
            RegWrite => RegWrite,
            ALUSrc   => ALUSrc,
            MemRead  => MemRead,
            MemWrite => MemWrite,
            MemToReg => MemToReg,
            Branch   => Branch,
            Jump     => Jump,
            ALUOP    => ALUOP
        );
    
    -- Proceso de estimulación
    stim_proc: process
        variable l : line;
    begin
        write(l, string'("=== INICIO DE SIMULACIÓN UNIDAD DE CONTROL RISC-V ==="));
        writeline(output, l);
        write(l, string'(""));
        writeline(output, l);
        
        -- Test 1: R-Type Instructions (add, sub, and, or, etc.)
        opcode <= "0110011";
        wait for clk_period;
        print_signals(opcode, "R-TYPE (add, sub, and, or, xor, slt)");
        
        -- Verificación R-Type
        assert (RegWrite = '1' and ALUSrc = '0' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '0' and ALUOP = "110")
        report "Error en R-Type instructions" severity error;
        
        -- Test 2: I-Type Instructions (addi, andi, ori, etc.)
        opcode <= "0010011";
        wait for clk_period;
        print_signals(opcode, "I-TYPE (addi, andi, ori, xori, slti)");
        
        -- Verificación I-Type
        assert (RegWrite = '1' and ALUSrc = '1' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '0' and ALUOP = "000")
        report "Error en I-Type instructions" severity error;
        
        -- Test 3: Load Instructions (lw, lb, lh)
        opcode <= "0000011";
        wait for clk_period;
        print_signals(opcode, "LOAD (lw, lb, lh, lbu, lhu)");
        
        -- Verificación Load
        assert (RegWrite = '1' and ALUSrc = '1' and MemRead = '1' and 
                MemWrite = '0' and MemToReg = '1' and Branch = '0' and 
                Jump = '0' and ALUOP = "000")
        report "Error en Load instructions" severity error;
        
        -- Test 4: Store Instructions (sw, sb, sh)
        opcode <= "0100011";
        wait for clk_period;
        print_signals(opcode, "STORE (sw, sb, sh)");
        
        -- Verificación Store
        assert (RegWrite = '0' and ALUSrc = '1' and MemRead = '0' and 
                MemWrite = '1' and MemToReg = '0' and Branch = '0' and 
                Jump = '0' and ALUOP = "000")
        report "Error en Store instructions" severity error;
        
        -- Test 5: Branch Instructions (beq, bne, blt, bge)
        opcode <= "1100011";
        wait for clk_period;
        print_signals(opcode, "BRANCH (beq, bne, blt, bge, bltu, bgeu)");
        
        -- Verificación Branch
        assert (RegWrite = '0' and ALUSrc = '0' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '1' and 
                Jump = '0' and ALUOP = "111")
        report "Error en Branch instructions" severity error;
        
        -- Test 6: JAL (Jump and Link)
        opcode <= "1101111";
        wait for clk_period;
        print_signals(opcode, "JAL (Jump and Link)");
        
        -- Verificación JAL
        assert (RegWrite = '1' and ALUSrc = '0' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '1' and ALUOP = "000")
        report "Error en JAL instruction" severity error;
        
        -- Test 7: JALR (Jump and Link Register)
        opcode <= "1100111";
        wait for clk_period;
        print_signals(opcode, "JALR (Jump and Link Register)");
        
        -- Verificación JALR
        assert (RegWrite = '1' and ALUSrc = '1' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '1' and ALUOP = "000")
        report "Error en JALR instruction" severity error;
        
        -- Test 8: LUI (Load Upper Immediate)
        opcode <= "0110111";
        wait for clk_period;
        print_signals(opcode, "LUI (Load Upper Immediate)");
        
        -- Verificación LUI
        assert (RegWrite = '1' and ALUSrc = '1' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '0' and ALUOP = "000")
        report "Error en LUI instruction" severity error;
        
        -- Test 9: AUIPC (Add Upper Immediate to PC)
        opcode <= "0010111";
        wait for clk_period;
        print_signals(opcode, "AUIPC (Add Upper Immediate to PC)");
        
        -- Verificación AUIPC
        assert (RegWrite = '1' and ALUSrc = '1' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '0' and ALUOP = "000")
        report "Error en AUIPC instruction" severity error;
        
        -- Test 10: Opcode inválido
        opcode <= "1111111";
        wait for clk_period;
        print_signals(opcode, "INVALID OPCODE (caso por defecto)");
        
        -- Verificación caso por defecto
        assert (RegWrite = '0' and ALUSrc = '0' and MemRead = '0' and 
                MemWrite = '0' and MemToReg = '0' and Branch = '0' and 
                Jump = '0' and ALUOP = "000")
        report "Error en caso por defecto" severity error;
        
        write(l, string'("=== SIMULACIÓN COMPLETADA EXITOSAMENTE ==="));
        writeline(output, l);
        
        wait;
    end process;

end Behavioral;