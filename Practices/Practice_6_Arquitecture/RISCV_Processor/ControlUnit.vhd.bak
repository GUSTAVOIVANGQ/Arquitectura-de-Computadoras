library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity ControlUnit is
    Port (
        opcode    : in  STD_LOGIC_VECTOR(6 downto 0);
        RegWrite  : out STD_LOGIC;
        ALUSrc    : out STD_LOGIC;
        MemRead   : out STD_LOGIC;
        MemWrite  : out STD_LOGIC;
        MemToReg  : out STD_LOGIC;
        Branch    : out STD_LOGIC;
        Jump      : out STD_LOGIC;
        ALUOP     : out STD_LOGIC_VECTOR(1 downto 0)
    );
end ControlUnit;

architecture Behavioral of ControlUnit is
begin
    process(opcode)
    begin
        -- Valores por defecto
        RegWrite <= '0';
        ALUSrc   <= '0';
        MemRead  <= '0';
        MemWrite <= '0';
        MemToReg <= '0';
        Branch   <= '0';
        Jump     <= '0';
        ALUOP    <= "00";
        
        case opcode is
            -- R-type (ADD) - opcode: 0110011
            when "0110011" =>
                RegWrite <= '1';
                ALUSrc   <= '0';  -- usa rs2
                MemRead  <= '0';
                MemWrite <= '0';
                MemToReg <= '0';  -- ALU result
                Branch   <= '0';
                Jump     <= '0';
                ALUOP    <= "10"; -- R-type
                
            -- I-type (ADDI) - opcode: 0010011
            when "0010011" =>
                RegWrite <= '1';
                ALUSrc   <= '1';  -- usa inmediato
                MemRead  <= '0';
                MemWrite <= '0';
                MemToReg <= '0';  -- ALU result
                Branch   <= '0';
                Jump     <= '0';
                ALUOP    <= "00"; -- ADD
                
            when others =>
                -- Mantener valores por defecto
                null;
        end case;
    end process;
end Behavioral;